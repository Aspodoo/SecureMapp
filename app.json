{
  "expo": {
    "name": "SecureMapp",
    "slug": "SecureMapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#0F141C"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SecureMapp necesita acceso a tu ubicación para mostrar alertas cercanas y trazar rutas seguras."
        }
      ]
    ]
  }
}